{
  // One config, not the three-file reference setup Vite scaffolds: this repo
  // has one app and no separate node-side source to type.
  //
  // The move off one big .jsx file is done — `src` is TypeScript throughout,
  // so there is no JavaScript left to allow or to leave unchecked.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    // Vite transpiles per file and never type-checks; `tsc` here is only ever
    // asked for a verdict, never for output.
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    // The app is browser-only; `scripts` is the one Node consumer, and it
    // wants `process` to set an exit code.
    "types": ["node"]
  },
  // `scripts` holds the streak sweep, which imports from `src` and must be
  // held to the same types — a sweep that has drifted out of type is a sweep
  // nobody trusts.
  "include": ["src", "scripts"]
}
